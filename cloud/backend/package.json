{
  "name": "remote-ac-backend",
  "version": "1.2.3",
  "private": true,
  "description": "Remote AC cloud backend: MQTT bridge, SQLite store, REST + WebSocket API, auth, weather proxy",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "fastify": "^4.28.1",
    "@fastify/cookie": "^9.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^10.0.1",
    "@fastify/static": "^6.12.0",
    "mqtt": "^5.7.1",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.8",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^9.0.8",
    "@types/node": "^24.0.0",
    "typescript": "^5.5.4",
    "tsx": "^4.16.2",
    "vitest": "^2.0.5"
  }
}
