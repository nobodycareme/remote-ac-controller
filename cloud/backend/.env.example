# =============================================================================
# Remote AC Controller — backend configuration template
# =============================================================================
# Copy to `.env` and adjust. Every value below is a NON-PRODUCTION default.
#
# Secrets (MQTT_PASSWORD, WEB_PASSWORD, SESSION_SECRET, IR_OWNER_PASSWORD)
# must NOT be committed. In the Docker deployment they are supplied through
# `deploy/secrets.env`, which is git-ignored.
#
# Authoritative schema: src/config.ts
# =============================================================================

# ── HTTP server ──────────────────────────────────────────────────────────────
# Bind to loopback and put a TLS-terminating reverse proxy in front of it.
PORT=3100
HOST=127.0.0.1

# Public URL of the web app. Used for origin validation — it must match the
# browser's Origin header exactly (scheme + host + port, no trailing slash).
PUBLIC_BASE_URL=https://ac.example.com
ALLOWED_ORIGINS=https://ac.example.com

# ── MQTT ─────────────────────────────────────────────────────────────────────
# Use mqtts:// with a real certificate in production.
MQTT_URL=mqtt://remote-ac-broker:1883
MQTT_USERNAME=remote-ac-backend
MQTT_PASSWORD=

# Device identity and topic namespace. Must match the firmware configuration
# and the broker ACL (see cloud/broker/acl/aclfile).
DEVICE_ID=bedroom-ac-01
TOPIC_PREFIX=remote-ac/v1/devices

# ── Authentication ───────────────────────────────────────────────────────────
# WEB_PASSWORD is an scrypt hash in `salt:hash` form, never plaintext.
WEB_USER=admin
WEB_PASSWORD=

# Sign your own. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-secret-change-me
SESSION_TTL_MIN=480

# login_required — every visitor must authenticate
# public_guest   — anonymous visitors get a read-only guest session
ACCESS_MODE=public_guest

# Long-lived trusted owner sessions (days).
TRUSTED_OWNER_SESSION_TTL_DAYS=365

# ── Database ─────────────────────────────────────────────────────────────────
# Embedded node:sqlite database file. Back this up; it holds sessions,
# telemetry history, schedules and automation rules.
DB_PATH=./data/app.db

# ── Infrared safety gates ────────────────────────────────────────────────────
# ALL of these default to disabled. Only the exact strings "true" or "1" are
# treated as enabled — see docs/security-model.md §5.

# Master switch for normal production control.
REAL_IR_PRODUCTION_CONTROL_ENABLED=false

# Master switch for the constrained debug/experiment path.
WEB_REAL_IR_ENABLED=false

# Debug session mechanism. Leave off unless you are actively bench-testing.
REAL_IR_DEBUG_MODE=false
# Absolute expiry, e.g. 2026-12-31T23:59:59Z. Blank means no time box.
REAL_IR_DEBUG_EXPIRES_AT=
# Allow-list — all three are required for the debug path to open.
REAL_IR_DEBUG_ALLOWED_CODE_ID=
REAL_IR_DEBUG_ALLOWED_CODE_SHA256=
REAL_IR_DEBUG_ALLOWED_CODE_LENGTH=0
# 0 = unlimited transmissions while the window is open.
REAL_IR_DEBUG_MAX_TOTAL_COMMANDS=3
REAL_IR_DEBUG_COOLDOWN_SECONDS=10
REAL_IR_DEBUG_COMMAND_TTL_SECONDS=30
REAL_IR_DEBUG_SESSION_TTL_SECONDS=3600

# Separate credential for the privileged IR path. Distinct from the web login,
# so a compromised web session alone cannot actuate hardware.
IR_OWNER_USER=admin
IR_OWNER_PASSWORD=

# Command idempotency / replay window. Mirrors the firmware exec cache
# (IR_EXEC_TTL_MS = 30000); keep the two consistent.
IR_COMMAND_TTL_MS=25000

# ── Device liveness ──────────────────────────────────────────────────────────
# Telemetry older than STALE_THRESHOLD_MS is shown as stale; older than
# OFFLINE_THRESHOLD_MS the device is treated as offline and commands are refused.
OFFLINE_THRESHOLD_MS=90000
STALE_THRESHOLD_MS=60000

# Reported device cadence — must mirror the firmware values, they are displayed
# verbatim in the UI.
DEVICE_PUBLISH_INTERVAL_MS=5000
DEVICE_SAMPLE_INTERVAL_MS=2500

# ── Weather ──────────────────────────────────────────────────────────────────
# Open-Meteo requires no API key. Set coordinates for your own location.
WEATHER_CITY=Example City
WEATHER_TIMEZONE=Asia/Shanghai
WEATHER_LATITUDE=34.3416
WEATHER_LONGITUDE=108.9398
WEATHER_CACHE_MS=600000
WEATHER_STALE_MS=1800000
WEATHER_REFRESH_MS=600000
