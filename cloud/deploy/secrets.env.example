# =============================================================================
# Deployment secrets template
# =============================================================================
# Copy to `secrets.env` in this directory and fill in real values.
# `deploy/secrets.env` is git-ignored and MUST NEVER be committed.
#
# docker-compose.yml loads this file into both the broker and the backend.
# The broker uses it to provision its password file on first start.
# =============================================================================

# ── MQTT accounts ────────────────────────────────────────────────────────────
# Two accounts with disjoint permissions; see cloud/broker/acl/aclfile.
# Usernames must match the ACL entries exactly.
#
# Generate passwords with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# Device account — publishes telemetry, subscribes to its own commands.
MQTT_DEVICE_USERNAME=remote-ac-device
MQTT_DEVICE_PASSWORD=

# Backend account — subscribes to telemetry, publishes commands.
MQTT_USERNAME=remote-ac-backend
MQTT_PASSWORD=

# ── Web application ──────────────────────────────────────────────────────────
# Cookie/session signing key. Rotating it invalidates all sessions.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Owner login password, stored as an scrypt hash in `salt:hash` form.
# NEVER store plaintext here.
WEB_USER=admin
WEB_PASSWORD=

# Separate credential authorising real infrared transmission.
# Keep it different from WEB_PASSWORD.
IR_OWNER_USER=admin
IR_OWNER_PASSWORD=
