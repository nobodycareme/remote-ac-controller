# Cloud tier ignore rules.
# The monorepo root .gitignore also applies; rules here take precedence for
# paths under cloud/. Verify with:  git check-ignore -v <path>

# ---- Environment files (templates are kept) ----
.env
.env.*
*.local
!.env.example
!**/.env.example

# ---- Docker ----
docker-compose.override.yml
infra/mosquitto/certs/*.key
infra/mosquitto/certs/*.pem
infra/mosquitto/certs/private/

# ---- Broker material: never commit keys or issued certificates ----
broker/certs/*.key
broker/certs/*.pem
broker/certs/*.crt
broker/run/
broker/data/

# ---- Data ----
data/
*.sqlite3
*.sqlite3-*

# ---- Logs ----
logs/
*.log

# ---- Node ----
node_modules/
dist/
dist.static/
.cache/

# Frontend tooling: keep the scripts, ignore local validation artifacts.
frontend/tools/screenshots/
frontend/dist/

# ---- IDE ----
.vscode/
.idea/

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Secrets ----
*.secret
private/
deploy/secrets.env
