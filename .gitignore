# ============================================================
# Remote AC Controller - Monorepo .gitignore
# Consolidated from firmware (PlatformIO/ESP8266) and cloud
# (Node.js/TypeScript) ignore rules. Review with:
#   git check-ignore -v <path>
#   git status --ignored
# ============================================================

# ---- Never publish (safety) ----
Private/
Evidence/
_QUARANTINE_/
*.bundle
*.zip
*.7z
*.tar.gz
*.rar
*.bak

# ---- Firmware (PlatformIO / ESP8266) ----
firmware/.pio/
firmware/.pio-core/
firmware/.pio-core-dir
firmware/.vscode/
firmware/*.bin
firmware/*.elf
firmware/*.map
firmware/*.hex
firmware/firmware.*.bin
firmware/build/
# Defensive guards: the real PlatformIO secret headers live under
# firmware/agent-platformio/include/ and are covered by that project's own
# .gitignore; these wildcards catch stray copies anywhere under firmware/.
firmware/**/secrets.h
firmware/**/cloud_secrets.h
# Real campus profile / secret files (commit *.example.h, ignore the real ones)
firmware/shared/RemoteACCore/src/config/campus_secrets.h
# Arduino IDE puts cloud credentials on the shared library's include path
firmware/shared/RemoteACCore/src/cloud_secrets.h
firmware/shared/RemoteACCore/src/secrets.h
firmware/shared/RemoteACCore/src/config/profiles/*
!firmware/shared/RemoteACCore/src/config/profiles/*.example.h
firmware/arduino-ide/**/profiles/*
!firmware/arduino-ide/**/profiles/*.example.h
# Legacy Arduino IDE local config (the config.h workflow was removed in v1.0.0;
# the rule stays as a guard so a stray local copy can never be committed)
firmware/arduino-ide/**/config.h
# Arduino IDE global feature-switch header (copy of .example.h, may enable live auth)
firmware/arduino-ide/**/Remote_AC_Controller.ino.globals.h
# Arduino IDE compile output (arduino-cli --output-dir)
firmware/arduino-ide/**/build/
# Generated Arduino-layout srun-c library (tools/prepare_srun_arduino_library.py
# writes it to a scratch/sketchbook directory outside the repository). These
# guards make it impossible for a stray copy to become a second authority.
**/srun-c-arduino/
srun-c-generated/
arduino-libraries-tmp/
# PlatformIO local work dir (build/, libdeps/, cache/, logs/)
firmware/agent-platformio/.build/
firmware/.build/
# Private IR capture / learned provider outputs
firmware/private_ir/
firmware/ir_capture/
firmware/learned_provider/
# Serial & build logs
*.log
serial_logs/
build_logs/

# ---- Cloud (Node.js / TypeScript) ----
cloud/**/node_modules/
cloud/**/.pnp/
cloud/**/.pnp.js
cloud/**/dist/
cloud/**/dist.static/
cloud/**/coverage/
cloud/**/.vite/
cloud/**/*.tsbuildinfo
cloud/**/.eslintcache
cloud/**/npm-debug.log*
cloud/**/yarn-debug.log*
cloud/**/yarn-error.log*
cloud/backend/.turbo/
cloud/frontend/.turbo/
# Env files (keep examples)
cloud/**/.env
cloud/**/.env.*
!cloud/**/.env.example
!cloud/backend/.env.example
!cloud/frontend/.env.example
# Local deploy artifacts
cloud/**/deploy/secrets.env
cloud/**/deploy/*.local
cloud/broker/certs/*.key
cloud/broker/certs/*.pem
cloud/broker/certs/ca.key
cloud/broker/certs/server.key

# ---- Databases / secrets ----
*.db
*.sqlite
*.sqlite3
*-wal
*-shm
*.db-journal

# ---- Certificates / private keys / backups ----
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
secrets/
keys/
backups/
server_backup/
serverside_backup/

# ---- Cookies / sessions / tokens ----
*cookie*
*session*
*.token
gh_token*
GITHUB_TOKEN
GH_TOKEN

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Python (tooling) ----
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ---- Monorepo CI artifacts ----
.github/ci-artifacts/
dist-tmp/
build-out/
